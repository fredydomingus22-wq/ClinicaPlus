# Porta do serviço FastAPI
PORT=8001

# ==========================================
# INFRAESTRUTURA BASE
# ==========================================

# Conexão com a base de dados (Leitura/Escrita — usada pelo asyncpg e db_layer)
# IMPORTANTE: Usar a Connection String do Supabase com o PgBouncer (Transaction Mode) - Porta 6543
DATABASE_URL=postgresql://user:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Conexão directa Postgres (usada pelo AsyncPostgresSaver do LangGraph)
# O psycopg3 NÃO suporta o parâmetro ?pgbouncer=true — usar porta 5432 (ligação directa)
# Encontras esta URL no Supabase: Settings > Database > Connection String > Direct connection
# NOTA: Se usares a porta 6543 (Transaction Mode), o sistema tentará desativar prepared statements automaticamente.
DIRECT_URL=postgresql://user:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Conexão Redis (Usado estritamente para Cost Tracking e Rate Limiting)
REDIS_URL=redis://localhost:6379

# ==========================================
# LLM PROVIDERS (NOVA ARQUITETURA LANGGRAPH)
# ==========================================

# Groq (Primary Provider - Llama-3 70b)
GROQ_API_KEY=your_groq_api_key_here

# Cerebras (Secondary Provider / Fallback)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Gemini (Tertiary Provider - modelo gemini-2.5-flash via langchain-google-genai)
# NOTA: Usar GOOGLE_API_KEY — é o nome que o langchain-google-genai lê por defeito
GOOGLE_API_KEY=your_gemini_api_key_here

# Anthropic (Utility Provider - Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ==========================================
# INTEGRAÇÕES DE DOMÍNIO
# ==========================================

# Configurações do Evolution API (WhatsApp)
EVOLUTION_API_URL=https://evolution.seuservidor.com
EVOLUTION_API_KEY=sua_api_key_global
EVOLUTION_WEBHOOK_SECRET=segredo_hmac_para_validar_webhooks

# Integração Interna (Chamada de ferramentas DB e Webhooks TS)
# API Core Node.js
TS_API_URL=http://localhost:3001
TS_API_INTERNAL_KEY=chave_secreta_partilhada_com_a_api_ts
