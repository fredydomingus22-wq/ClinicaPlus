/// SessÃµes de impersonation: super admin entra como admin de uma clÃ­nica
model ImpersonationSession {
  id              String    @id @default(cuid())
  superAdminId    String    // quem estÃ¡ a impersonar
  targetClinicaId String
  targetAdminId   String
  token           String    @unique // SHA-256 do JWT raw token
