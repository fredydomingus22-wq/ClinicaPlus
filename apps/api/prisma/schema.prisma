generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Clinica {
  id                   String                 @id @default(cuid())
  nome                 String
  slug                 String                 @unique
  logo                 String?
  telefone             String?
  email                String                 @unique
  endereco             String?
  cidade               String?
  provincia            String?
  plano                Plano                  @default(BASICO)
  ativo                Boolean                @default(true)
  criadoEm             DateTime               @default(now())
  atualizadoEm         DateTime               @updatedAt
  subscricaoValidaAte  DateTime?
  motivoSuspensao      String?
  notasInternas        String?
  suspensaEm           DateTime?
  subscricaoEstado     EstadoSubscricao       @default(TRIAL)
  agtSoftwareCert      String?
  enderecoPostal       String?
  nif                  String?
  razaoSocial          String?
  regimeFiscal         RegimeFiscal           @default(GERAL)
  serieDocFiscal       String                 @default("CPLS")
  agtPrivateKey        String?
  agtPublicKey         String?
  logotipoUrl          String?
  tipoEntidade         String?                @default("EMPRESA")
  agendamentos         Agendamento[]
  anamneseTemplates    AnamneseTemplate[]
  anamneses            Anamnese[]
  apiKeys              ApiKey[]
  botIntegracoes       BotIntegracao[]
  categoriasProduto    CategoriaProduto[]
  configuracao         ConfiguracaoClinica?
  contactos            ContactoClinica[]
  contractDocuments    ContractDocument[]
  contractEvents       ContractEvent[]
  contracts            Contract[]
  documentos           Documento[]
  especialidades       Especialidade[]
  lotesEstoque         EstoqueLote[]
  movimentacoesEstoque MovimentacaoEstoque[]
  exames               Exame[]
  Fatura               Fatura[]
  faturasAssinatura    FaturaAssinatura[]
  impersonacoes        ImpersonationSession[]
  lembretes            LembreteAgendamento[]
  medicos              Medico[]
  odontogramas         Odontograma[]
  pacientes            Paciente[]
  planosTratamento     PlanoTratamento[]
  produtos             Produto[]
  prontuarios          Prontuario[]
  receitas             Receita[]
  sequencias           SequenciaDocFiscal[]
  sessoesTratamento    SessaoTratamento[]
  subscricoes          Subscricao[]
  tiposExamesClinica   TipoExameClinica[]
  tiposTratamento      TipoTratamento[]
  utilizadores         Utilizador[]
  waInstancias         WaInstancia[]
  webhooks             Webhook[]

  @@index([slug])
  @@index([suspensaEm])
  @@map("clinicas")
}

model ContactoClinica {
  id        String   @id @default(cuid())
  clinicaId String
  tipo      String
  valor     String
  descricao String?
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now())
  clinica   Clinica  @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@index([clinicaId])
  @@map("contactos_clinica")
}

model Utilizador {
  id                     String                 @id @default(cuid())
  clinicaId              String?
  nome                   String
  email                  String
  passwordHash           String
  papel                  Papel
  ativo                  Boolean                @default(true)
  criadoEm               DateTime               @default(now())
  atualizadoEm           DateTime               @updatedAt
  mfaActivatedAt         DateTime?
  mfaPending             Boolean                @default(false)
  mfaSecret              String?
  avatarUrl              String?
  impersonacoesFeitas    ImpersonationSession[] @relation("SuperAdminImpersonations")
  impersonacoesRecebidas ImpersonationSession[] @relation("ImpersonatedSessions")
  medico                 Medico?
  notificacoes           Notificacao[]
  paciente               Paciente?
  refreshTokens          RefreshToken[]
  systemLogs             SystemLog[]
  permissoes             UtilizadorPermissao[]
  clinica                Clinica?               @relation(fields: [clinicaId], references: [id])

  @@unique([clinicaId, email])
  @@index([clinicaId])
  @@index([clinicaId, papel])
  @@map("utilizadores")
}

model RefreshToken {
  id           String     @id @default(cuid())
  utilizadorId String
  token        String     @unique
  expiresAt    DateTime
  usedAt       DateTime?
  criadoEm     DateTime   @default(now())
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@index([utilizadorId])
  @@index([token])
  @@map("refresh_tokens")
}

model Paciente {
  id               String            @id @default(cuid())
  clinicaId        String
  numeroPaciente   String
  utilizadorId     String?           @unique
  nome             String
  dataNascimento   DateTime
  genero           String
  tipoSangue       String?
  alergias         String[]          @default([])
  telefone         String?
  email            String?
  endereco         String?
  provincia        String?
  seguroSaude      Boolean           @default(false)
  seguradora       String?
  ativo            Boolean           @default(true)
  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt
  origem           String?           @default("DIRECTO")
  perfilWa         Json?             @map("perfil_wa")
  cidade           String?
  nif              String?           @default("999999999")
  avatarUrl        String?
  agendamentos     Agendamento[]
  anamneses        Anamnese[]
  contracts        Contract[]
  documentos       Documento[]
  exames           Exame[]
  Fatura           Fatura[]
  odontogramas     Odontograma[]
  clinica          Clinica           @relation(fields: [clinicaId], references: [id])
  utilizador       Utilizador?       @relation(fields: [utilizadorId], references: [id])
  planosTratamento PlanoTratamento[]
  prontuarios      Prontuario[]
  receitas         Receita[]
  waConversas      WaConversa[]

  @@unique([clinicaId, numeroPaciente])
  @@index([clinicaId])
  @@index([clinicaId, nome])
  @@map("pacientes")
}

model Medico {
  id               String            @id @default(cuid())
  clinicaId        String
  utilizadorId     String            @unique
  nome             String
  ordem            String?
  telefoneDireto   String?
  /// Forma: { [segunda...domingo]: { ativo: boolean, inicio?: string, fim?: string, pausaInicio?: string, pausaFim?: string } }
  horario          Json
  duracaoConsulta  Int               @default(30)
  preco            Int               @default(0)
  ativo            Boolean           @default(true)
  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt
  especialidadeId  String
  agendamentos     Agendamento[]
  anamneses        Anamnese[]
  documentos       Documento[]
  exames           Exame[]
  Fatura           Fatura[]
  itensFatura      ItemFatura[]      @relation("ItemFaturaMedico")
  clinica          Clinica           @relation(fields: [clinicaId], references: [id])
  especialidade    Especialidade     @relation(fields: [especialidadeId], references: [id])
  utilizador       Utilizador        @relation(fields: [utilizadorId], references: [id])
  odontogramas     Odontograma[]
  planosTratamento PlanoTratamento[]
  prontuarios      Prontuario[]
  receitas         Receita[]

  @@index([clinicaId])
  @@index([clinicaId, especialidadeId])
  @@map("medicos")
}

model Especialidade {
  id               String            @id @default(cuid())
  clinicaId        String
  nome             String
  descricao        String?
  ativo            Boolean           @default(true)
  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt
  anamneseTemplate AnamneseTemplate?
  clinica          Clinica           @relation(fields: [clinicaId], references: [id])
  medicos          Medico[]

  @@unique([clinicaId, nome])
  @@index([clinicaId])
  @@map("especialidades")
}

model Agendamento {
  id                String                @id @default(cuid())
  clinicaId         String
  pacienteId        String
  medicoId          String
  dataHora          DateTime
  duracao           Int                   @default(30)
  tipo              TipoAgendamento       @default(CONSULTA)
  estado            EstadoAgendamento     @default(PENDENTE)
  motivoConsulta    String?
  observacoes       String?
  /// Forma: { pa: string, temperatura: number, peso: number, altura: number, imc: number, frequenciaCardiaca: number, sintomas: string[], urgencia: string }
  triagem           Json?
  notasConsulta     String?
  diagnostico       String?
  canceladoPor      String?
  canceladoEm       DateTime?
  criadoEm          DateTime              @default(now())
  atualizadoEm      DateTime              @updatedAt
  canal             String?               @default("PRESENCIAL")
  confirmadoWa      Boolean               @default(false) @map("confirmado_wa")
  clinica           Clinica               @relation(fields: [clinicaId], references: [id])
  medico            Medico                @relation(fields: [medicoId], references: [id])
  paciente          Paciente              @relation(fields: [pacienteId], references: [id])
  anamnese          Anamnese?
  documentos        Documento[]
  exames            Exame[]
  Fatura            Fatura?
  lembretes         LembreteAgendamento[]
  odontograma       Odontograma?
  planosOrigem      PlanoTratamento[]     @relation("AgendamentoPlanoTratamento")
  prontuario        Prontuario?
  receita           Receita?
  sessoesTratamento SessaoTratamento?

  @@index([clinicaId])
  @@index([clinicaId, dataHora])
  @@index([clinicaId, medicoId, dataHora])
  @@index([clinicaId, pacienteId])
  @@index([clinicaId, estado])
  @@map("agendamentos")
}

model Receita {
  id            String      @id @default(cuid())
  clinicaId     String
  agendamentoId String      @unique
  pacienteId    String
  medicoId      String
  diagnostico   String
  /// Forma: Array<{ nome: string, dosagem: string, frequencia: string, duracao: string, instrucoes?: string }>
  medicamentos  Json
  observacoes   String?
  dataEmissao   DateTime    @default(now())
  dataValidade  DateTime
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id])
  clinica       Clinica     @relation(fields: [clinicaId], references: [id])
  medico        Medico      @relation(fields: [medicoId], references: [id])
  paciente      Paciente    @relation(fields: [pacienteId], references: [id])

  @@index([clinicaId])
  @@index([clinicaId, pacienteId])
  @@map("receitas")
}

model LembreteAgendamento {
  id            String      @id @default(cuid())
  clinicaId     String
  agendamentoId String
  tipo          String
  agendadoPara  DateTime
  enviadoEm     DateTime?
  sucesso       Boolean?
  erro          String?
  criadoEm      DateTime    @default(now())
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id])
  clinica       Clinica     @relation(fields: [clinicaId], references: [id])

  @@index([clinicaId])
  @@index([agendadoPara, enviadoEm])
  @@map("lembretes_agendamento")
}

model ConfiguracaoClinica {
  id                String   @id @default(cuid())
  clinicaId         String   @unique
  lembrete24h       Boolean  @default(true)
  lembrete2h        Boolean  @default(true)
  horasAntecedencia Int      @default(24)
  moedaSimbolo      String   @default("Kz")
  fusoHorario       String   @default("Africa/Luanda")
  atualizadoEm      DateTime @updatedAt
  agendamentoOnline Boolean  @default(false)
  preTriagem        Boolean  @default(true)
  prontuarioCustom  Boolean  @default(false)
  corPrimaria       String?
  enderecoFatura    String?
  faturaAuto        Boolean  @default(false)
  iban              String?
  logoUrl           String?
  nif               String?
  seguradoras       String[] @default(["ENSA", "AAA Seguros", "Medicel", "Codil", "Nossa Seguros", "SAS", "IMPAR"])
  clinica           Clinica  @relation(fields: [clinicaId], references: [id])

  @@map("configuracoes_clinica")
}

model Notificacao {
  id           String     @id @default(cuid())
  utilizadorId String
  titulo       String
  mensagem     String
  tipo         String     @default("INFO")
  lida         Boolean    @default(false)
  url          String?
  criadoEm     DateTime   @default(now())
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@index([utilizadorId, lida])
  @@map("notificacoes")
}

model SystemLog {
  id           String      @id @default(cuid())
  nivel        String      @default("INFO")
  mensagem     String
  acao         String?
  utilizadorId String?
  detalhes     Json?
  criadoEm     DateTime    @default(now())
  utilizador   Utilizador? @relation(fields: [utilizadorId], references: [id])

  @@index([nivel])
  @@index([acao])
  @@map("system_logs")
}

model GlobalSettings {
  id                   String   @id @default("global_settings")
  modoManutencao       Boolean  @default(false)
  registoNovasClinicas Boolean  @default(true)
  maxUploadSizeMb      Int      @default(5)
  mensagemSistema      String?
  atualizadoEm         DateTime @updatedAt

  @@map("global_settings")
}

model Subscricao {
  id                String                  @id @default(cuid())
  clinicaId         String
  plano             Plano
  alteradoPor       String                  @default("SISTEMA")
  criadoEm          DateTime                @default(now())
  inicioEm          DateTime                @default(now())
  notas             String?
  planoAnterior     Plano?
  razao             RazaoMudancaPlano       @default(UPGRADE_MANUAL)
  referenciaInterna String?
  trialAte          DateTime?
  validaAte         DateTime?
  valorKz           Int?
  atualizadoEm      DateTime                @updatedAt
  estado            EstadoSubscricao        @default(TRIAL)
  notificacoes      SubscricaoNotificacao[]
  clinica           Clinica                 @relation(fields: [clinicaId], references: [id])

  @@index([clinicaId, estado])
  @@index([clinicaId, criadoEm(sort: Desc)])
  @@index([validaAte])
  @@map("subscricoes")
}

model SubscricaoNotificacao {
  id           String     @id @default(cuid())
  subscricaoId String
  tipo         String
  enviadoEm    DateTime?
  erro         String?
  subscricao   Subscricao @relation(fields: [subscricaoId], references: [id])

  @@unique([subscricaoId, tipo])
  @@map("subscricao_notificacoes")
}

model FaturaAssinatura {
  id             String    @id @default(cuid())
  clinicaId      String
  numero         String    @unique
  valor          Int
  moeda          String    @default("AOA")
  status         String    @default("PENDENTE")
  dataEmissao    DateTime  @default(now())
  dataPagamento  DateTime?
  dataVencimento DateTime
  urlPdf         String?
  clinica        Clinica   @relation(fields: [clinicaId], references: [id])

  @@index([clinicaId])
  @@map("faturas_assinatura")
}

model Fatura {
  id               String              @id @default(cuid())
  clinicaId        String
  numeroFatura     String
  agendamentoId    String?             @unique
  pacienteId       String
  medicoId         String?
  tipo             TipoFatura          @default(PARTICULAR)
  estado           EstadoFatura        @default(RASCUNHO)
  subtotal         Int
  desconto         Int                 @default(0)
  total            Int
  notas            String?
  dataEmissao      DateTime?
  dataVencimento   DateTime?
  criadoEm         DateTime            @default(now())
  atualizadoEm     DateTime            @updatedAt
  agtRequestID     String?
  documentoChave   String?
  fiscalHash       String?
  hashControl      String?             @default("1")
  moeda            String              @default("AOA")
  retencaoFonte    Int                 @default(0)
  statusEnvio      String              @default("PENDENTE")
  tipoDocFiscal    TipoDocumentoFiscal @default(FT)
  valorExtenso     String?
  valorPago        Int                 @default(0)
  totalIva         Int                 @default(0)
  faturaOriginalId String?
  motivoAnulacao   String?
  serieDocFiscal   String              @default("CPLS")
  emContingencia   Boolean             @default(false)
  snapshot         FaturaSnapshot?
  agendamento      Agendamento?        @relation(fields: [agendamentoId], references: [id])
  clinica          Clinica             @relation(fields: [clinicaId], references: [id])
  faturaOriginal   Fatura?             @relation("FaturaAnulacao", fields: [faturaOriginalId], references: [id])
  notasCredito     Fatura[]            @relation("FaturaAnulacao")
  medico           Medico?             @relation(fields: [medicoId], references: [id])
  paciente         Paciente            @relation(fields: [pacienteId], references: [id])
  itens            ItemFatura[]
  pagamentos       Pagamento[]

  @@index([clinicaId])
  @@index([clinicaId, estado])
  @@index([clinicaId, pacienteId])
  @@index([clinicaId, dataEmissao])
  @@index([clinicaId, serieDocFiscal, tipoDocFiscal, estado])
  @@map("faturas")
}

model ItemFatura {
  id            String         @id @default(cuid())
  faturaId      String
  tipoItem      TipoItemFatura @default(SERVICO)
  
  // Campos polimórficos (apenas um preenchido por tipo)
  produtoId     String?
  tratamentoId  String?
  exameId       String?
  medicoId      String?
  
  descricao     String
  quantidade    Int     @default(1)
  precoUnit     Int
  desconto      Int     @default(0)
  total         Int
  codigoIva     String  @default("ISE")
  motivoIsencao String?
  taxaIva       Float   @default(0)
  fatura        Fatura  @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  
  // Relações polimórficas
  produto       Produto?           @relation("ItemFaturaProduto", fields: [produtoId], references: [id])
  tratamento    TipoTratamento?    @relation("ItemFaturaTratamento", fields: [tratamentoId], references: [id])
  exame         TipoExameClinica?  @relation("ItemFaturaExame", fields: [exameId], references: [id])
  medico        Medico?            @relation("ItemFaturaMedico", fields: [medicoId], references: [id])

  @@map("itens_fatura")
}

model Pagamento {
  id             String           @id @default(cuid())
  clinicaId      String
  faturaId       String
  metodo         MetodoPagamento
  valor          Int
  referencia     String?
  notas          String?
  criadoEm       DateTime         @default(now())
  criadoPor      String
  numeroRecibo   String?
  fiscalHash     String?
  documentoChave String?
  fatura         Fatura           @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  seguro         SeguroPagamento?

  @@index([clinicaId])
  @@index([faturaId])
  @@map("pagamentos")
}

model SeguroPagamento {
  id                 String       @id @default(cuid())
  pagamentoId        String       @unique
  seguradora         String
  numeroBeneficiario String
  numeroAutorizacao  String?
  estado             EstadoSeguro @default(PENDENTE)
  valorSolicitado    Int
  valorAprovado      Int?
  dataSubmissao      DateTime?
  dataResposta       DateTime?
  notasSeguradora    String?
  pagamento          Pagamento    @relation(fields: [pagamentoId], references: [id])

  @@map("seguros_pagamento")
}

model Prontuario {
  id            String       @id @default(cuid())
  clinicaId     String
  pacienteId    String
  medicoId      String
  agendamentoId String?      @unique
  notas         String
  diagnostico   String?
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt
  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id])
  clinica       Clinica      @relation(fields: [clinicaId], references: [id])
  medico        Medico       @relation(fields: [medicoId], references: [id])
  paciente      Paciente     @relation(fields: [pacienteId], references: [id])

  @@index([clinicaId])
  @@index([pacienteId])
  @@map("prontuarios")
}

model Exame {
  id             String            @id @default(cuid())
  clinicaId      String
  pacienteId     String
  medicoId       String
  agendamentoId  String?
  nome           String
  tipo           TipoExame         @default(LABORATORIO)
  status         String            @default("PENDENTE")
  resultado      String?
  dataPedido     DateTime          @default(now())
  dataResultado  DateTime?
  criadoEm       DateTime          @default(now())
  atualizadoEm   DateTime          @updatedAt
  dataRealizacao DateTime?
  descricao      String?
  estado         EstadoExame       @default(PENDENTE)
  laudoNota      String?
  laudoUrl       String?
  tipoExameId    String?
  agendamento    Agendamento?      @relation(fields: [agendamentoId], references: [id])
  clinica        Clinica           @relation(fields: [clinicaId], references: [id])
  medico         Medico            @relation(fields: [medicoId], references: [id])
  paciente       Paciente          @relation(fields: [pacienteId], references: [id])
  tipoCatalogo   TipoExameClinica? @relation(fields: [tipoExameId], references: [id])

  @@index([clinicaId])
  @@index([pacienteId])
  @@index([clinicaId, estado])
  @@map("exames")
}

model Documento {
  id            String        @id @default(cuid())
  clinicaId     String
  pacienteId    String
  medicoId      String?
  agendamentoId String?
  tipo          TipoDocumento
  nome          String
  url           String
  criadoEm      DateTime      @default(now())
  agendamento   Agendamento?  @relation(fields: [agendamentoId], references: [id])
  clinica       Clinica       @relation(fields: [clinicaId], references: [id])
  medico        Medico?       @relation(fields: [medicoId], references: [id])
  paciente      Paciente      @relation(fields: [pacienteId], references: [id])

  @@index([clinicaId])
  @@index([pacienteId])
  @@map("documentos")
}

model WaInstancia {
  id                String            @id @default(cuid())
  clinicaId         String
  /// Nome da instÃ¢ncia na Evolution API ("cp-slug-abc123"). Pode ser vazio em instÃ¢ncias Meta puras.
  evolutionName     String            @unique
  evolutionToken    String
  estado            WaEstadoInstancia @default(DESCONECTADO)
  numeroTelefone    String?
  qrCodeBase64      String?
  criadoEm          DateTime          @default(now())
  atualizadoEm      DateTime          @updatedAt
  qrExpiresAt       DateTime?
  /// Meta: System User Access Token (armazenar encriptado em produÃ§Ã£o)
  metaAccessToken   String?
  /// Meta: Phone Number ID obtido no Meta Business Suite â†’ WhatsApp â†’ API Setup
  metaPhoneNumberId String?
  /// Meta: WhatsApp Business Account ID
  metaWabaId        String?
  /// Tipo de integraÃ§Ã£o: BAILEYS (padrÃ£o, via Evolution API) ou META_CLOUD (API oficial Meta)
  tipoIntegracao    WaTipoIntegracao  @default(BAILEYS)
  botIntegracao     BotIntegracao?
  automacoes        WaAutomacao[]
  conversas         WaConversa[]
  clinica           Clinica           @relation(fields: [clinicaId], references: [id])

  @@index([clinicaId])
  @@index([tipoIntegracao])
  @@map("wa_instancias")
}

model BotIntegracao {
  id               String       @id @default(cuid())
  clinicaId        String
  instanciaId      String?      @unique
  provedor         ProvedorBot  @default(TYPEBOT)
  apiUrl           String?
  flowId           String?
  apiToken         String?
  variaveisGlobais Json         @default("{}")
  triggerKeyword   String?
  expireTime       Int          @default(20)
  unknownMessage   String?
  ativo            Boolean      @default(true)
  criadoEm         DateTime     @default(now())
  atualizadoEm     DateTime     @updatedAt
  clinica          Clinica      @relation(fields: [clinicaId], references: [id])
  instancia        WaInstancia? @relation(fields: [instanciaId], references: [id])

  @@index([clinicaId])
  @@map("bot_integracoes")
}

model WaAutomacao {
  id             String          @id @default(cuid())
  tipo           WaTipoAutomacao
  ativo          Boolean         @default(false)
  n8nWorkflowId  String?
  n8nWebhookPath String?
  configuracao   Json            @default("{}")
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt
  clinicaId      String
  n8nWebhookUrl  String?
  instanciaId    String          @map("waInstanciaId")
  instancia      WaInstancia     @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  @@unique([instanciaId, tipo])
  @@index([instanciaId])
