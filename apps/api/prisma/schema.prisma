generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Clinica {
  id                  String                @id @default(cuid())
  nome                String
  slug                String                @unique
  tipoEntidade        String?               @default("EMPRESA") // SINGULAR ou EMPRESA
  logo                String?               @db.Text
  logotipoUrl         String?               @db.Text
  telefone            String?
  email               String                @unique
  endereco            String?
  cidade              String?
  provincia           String?
  plano               Plano                 @default(BASICO)
  ativo               Boolean               @default(true)
  criadoEm            DateTime              @default(now())
  atualizadoEm        DateTime              @updatedAt
  subscricaoValidaAte DateTime?
  subscricaoEstado    EstadoSubscricao      @default(TRIAL)

  // Campos Fiscais (AGT)
  nif                 String?
  razaoSocial         String?
  regimeFiscal        RegimeFiscal          @default(GERAL)
  agtSoftwareCert     String?               // NÃºmero de certificaÃ§Ã£o do software
  enderecoPostal      String?               // Logradouro, NÃºmero, etc. por SAF-T
  agtApiToken         String?               // Credenciais API (Basic Auth: username:password ou Base64)
  agtPrivateKey       String?   @db.Text    // Chave privada emitida pela AGT para o contribuinte
  agtPublicKey        String?   @db.Text    // Chave pÃºblica emitida pela AGT para o contribuinte
  serieDocFiscal      String                @default("CPLS") // SÃ©rie documental (ex: CPLS, 2026, etc)

  // migration_009: campos de suspensÃ£o e notas internas do super admin
  suspensaEm          DateTime?             // null = activa
  motivoSuspensao     String?
  notasInternas       String?               // visÃ­veis APENAS ao super admin
  subscricoes         Subscricao[]
  agendamentos        Agendamento[]
  apiKeys             ApiKey[]
  configuracao        ConfiguracaoClinica?
  contactos           ContactoClinica[]
  documentos          Documento[]
  especialidades      Especialidade[]
  exames              Exame[]
  Fatura              Fatura[]
  faturasAssinatura   FaturaAssinatura[]
  impersonacoes       ImpersonationSession[]
  lembretes           LembreteAgendamento[]
  medicos             Medico[]
  pacientes           Paciente[]
  prontuarios         Prontuario[]
  receitas            Receita[]
  utilizadores        Utilizador[]
  waInstancias        WaInstancia[]
  webhooks            Webhook[]
  sessoesTratamento   SessaoTratamento[]
  planosTratamento    PlanoTratamento[]
  tiposTratamento     TipoTratamento[]
  tiposExamesClinica  TipoExameClinica[]
  botIntegracoes      BotIntegracao[]
  sequencias          SequenciaDocFiscal[]
  // InventÃ¡rio
  categoriasProduto   CategoriaProduto[]
  produtos            Produto[]
  lotesEstoque        EstoqueLote[]
  movimentacoesEstoque MovimentacaoEstoque[]
  anamneses           Anamnese[]
  odontogramas        Odontograma[]
  anamneseTemplates   AnamneseTemplate[]
  contracts           Contract[]
  contractEvents      ContractEvent[]
  contractDocuments   ContractDocument[]


  @@index([slug])
  @@index([suspensaEm])  // para filtrar clinicas activas/suspensas
  @@map("clinicas")
}

model ContactoClinica {
  id        String   @id @default(cuid())
  clinicaId String
  tipo      String
  valor     String
  descricao String?
  ordem     Int      @default(0)
  criadoEm  DateTime @default(now())
  clinica   Clinica  @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@index([clinicaId])
  @@map("contactos_clinica")
}

model Utilizador {
  id                   String                @id @default(cuid())
  clinicaId            String?
  nome                 String
  email                String
  avatarUrl            String?               @db.Text
  passwordHash         String
  papel                Papel
  ativo                Boolean               @default(true)
  criadoEm             DateTime              @default(now())
  atualizadoEm         DateTime              @updatedAt
  // migration_009: MFA para SUPER_ADMIN (TOTP)
  mfaSecret            String?               // secret TOTP encriptado com APP_SECRET
  mfaPending           Boolean               @default(false) // true = setup iniciado mas nÃ£o confirmado
  mfaActivatedAt       DateTime?             // null = MFA nÃ£o activado ainda
  medico               Medico?
  notificacoes         Notificacao[]
  paciente             Paciente?
  refreshTokens        RefreshToken[]
  systemLogs           SystemLog[]
  permissoes           UtilizadorPermissao[]
  clinica              Clinica?              @relation(fields: [clinicaId], references: [id])
  impersonacoesFeitas  ImpersonationSession[] @relation("SuperAdminImpersonations")
  impersonacoesRecebidas ImpersonationSession[] @relation("ImpersonatedSessions")

  @@unique([clinicaId, email])
  @@index([clinicaId])
  @@index([clinicaId, papel])
  @@map("utilizadores")
}

model RefreshToken {
  id           String     @id @default(cuid())
  utilizadorId String
  token        String     @unique
  expiresAt    DateTime
  usedAt       DateTime?
  criadoEm     DateTime   @default(now())
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@index([utilizadorId])
  @@index([token])
  @@map("refresh_tokens")
}

model Paciente {
  id             String        @id @default(cuid())
  clinicaId      String
  numeroPaciente String
  utilizadorId   String?       @unique
  nome           String
  avatarUrl      String?       @db.Text
  dataNascimento DateTime
  genero         String
  tipoSangue     String?
  alergias       String[]      @default([])
  telefone       String?
  email          String?
  endereco       String?
  provincia      String?
  cidade         String?
  nif            String?       @default("999999999")
  seguroSaude    Boolean       @default(false)
  seguradora     String?
  ativo          Boolean       @default(true)
  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt
  origem         String?       @default("DIRECTO")
  agendamentos   Agendamento[]
  documentos     Documento[]
  exames         Exame[]
  Fatura         Fatura[]
  clinica        Clinica       @relation(fields: [clinicaId], references: [id])
  utilizador     Utilizador?   @relation(fields: [utilizadorId], references: [id])
  prontuarios    Prontuario[]
  receitas       Receita[]
  waConversas    WaConversa[]
  perfilWa       Json?         @map("perfil_wa") // Meta-dados do WhatsApp (sessÃ£o Intel)
  planosTratamento  PlanoTratamento[]
  anamneses      Anamnese[]
  odontogramas   Odontograma[]
  contracts      Contract[]


  @@unique([clinicaId, numeroPaciente])
  @@index([clinicaId])
  @@index([clinicaId, nome])
  @@map("pacientes")
}

model Medico {
  id              String        @id @default(cuid())
  clinicaId       String
  utilizadorId    String        @unique
  nome            String
  ordem           String?
  telefoneDireto  String?
  /// Forma: { [segunda...domingo]: { ativo: boolean, inicio?: string, fim?: string, pausaInicio?: string, pausaFim?: string } }
  horario         Json
  duracaoConsulta Int           @default(30)
  preco           Int           @default(0)
  ativo           Boolean       @default(true)
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt
  especialidadeId String
  agendamentos    Agendamento[]
  documentos      Documento[]
  exames          Exame[]
  Fatura          Fatura[]
  clinica         Clinica       @relation(fields: [clinicaId], references: [id])
  especialidade   Especialidade @relation(fields: [especialidadeId], references: [id])
  utilizador      Utilizador    @relation(fields: [utilizadorId], references: [id])
  prontuarios     Prontuario[]
  receitas        Receita[]
  planosTratamento PlanoTratamento[]
  anamneses       Anamnese[]
  odontogramas    Odontograma[]

  @@index([clinicaId])
  @@index([clinicaId, especialidadeId])
  @@map("medicos")
}

model Especialidade {
  id           String   @id @default(cuid())
  clinicaId    String
  nome         String
  descricao    String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  clinica      Clinica  @relation(fields: [clinicaId], references: [id])
  medicos      Medico[]
  anamneseTemplate AnamneseTemplate?

  @@unique([clinicaId, nome])
  @@index([clinicaId])
  @@map("especialidades")
}

model Agendamento {
  id             String                @id @default(cuid())
  clinicaId      String
  pacienteId     String
  medicoId       String
  dataHora       DateTime
  duracao        Int                   @default(30)
  tipo           TipoAgendamento       @default(CONSULTA)
  estado         EstadoAgendamento     @default(PENDENTE)
  motivoConsulta String?
  observacoes    String?
  /// Forma: { pa: string, temperatura: number, peso: number, altura: number, imc: number, frequenciaCardiaca: number, sintomas: string[], urgencia: string }
  triagem        Json?
  notasConsulta  String?
  diagnostico    String?
  canceladoPor   String?
  canceladoEm    DateTime?
  criadoEm       DateTime              @default(now())
  atualizadoEm   DateTime              @updatedAt
  canal          String?               @default("PRESENCIAL")
  clinica        Clinica               @relation(fields: [clinicaId], references: [id])
  medico         Medico                @relation(fields: [medicoId], references: [id])
  paciente       Paciente              @relation(fields: [pacienteId], references: [id])
  documentos     Documento[]
  exames         Exame[]
  Fatura         Fatura?
  lembretes      LembreteAgendamento[]
  prontuario     Prontuario?
  receita        Receita?
  anamnese       Anamnese?
  odontograma    Odontograma?
  confirmadoWa   Boolean               @default(false) @map("confirmado_wa") // ConfirmaÃ§Ã£o via Intel


  planosOrigem   PlanoTratamento[]     @relation("AgendamentoPlanoTratamento")
  sessoesTratamento SessaoTratamento[]


  @@index([clinicaId])
  @@index([clinicaId, dataHora])
  @@index([clinicaId, medicoId, dataHora])
  @@index([clinicaId, pacienteId])
  @@index([clinicaId, estado])
  @@map("agendamentos")
}

model Receita {
  id            String      @id @default(cuid())
  clinicaId     String
  agendamentoId String      @unique
  pacienteId    String
  medicoId      String
  diagnostico   String
  /// Forma: Array<{ nome: string, dosagem: string, frequencia: string, duracao: string, instrucoes?: string }>
  medicamentos  Json
  observacoes   String?
  dataEmissao   DateTime    @default(now())
  dataValidade  DateTime
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id])
  clinica       Clinica     @relation(fields: [clinicaId], references: [id])
  medico        Medico      @relation(fields: [medicoId], references: [id])
  paciente      Paciente    @relation(fields: [pacienteId], references: [id])

  @@index([clinicaId])
  @@index([clinicaId, pacienteId])
  @@map("receitas")
}

model LembreteAgendamento {
  id            String      @id @default(cuid())
  clinicaId     String
  agendamentoId String
  tipo          String
  agendadoPara  DateTime
  enviadoEm     DateTime?
  sucesso       Boolean?
  erro          String?
  criadoEm      DateTime    @default(now())
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id])
  clinica       Clinica     @relation(fields: [clinicaId], references: [id])

  @@index([clinicaId])
  @@index([agendadoPara, enviadoEm])
  @@map("lembretes_agendamento")
}

model ConfiguracaoClinica {
  id                String   @id @default(cuid())
  clinicaId         String   @unique
  lembrete24h       Boolean  @default(true)
  lembrete2h        Boolean  @default(true)
  horasAntecedencia Int      @default(24)
  moedaSimbolo      String   @default("Kz")
  fusoHorario       String   @default("Africa/Luanda")
  atualizadoEm      DateTime @updatedAt
  agendamentoOnline Boolean  @default(false)
  preTriagem        Boolean  @default(true)
  prontuarioCustom  Boolean  @default(false)
  corPrimaria       String?
  enderecoFatura    String?
  faturaAuto        Boolean  @default(false)
  iban              String?
  logoUrl           String?
  nif               String?
  seguradoras       String[] @default(["ENSA", "AAA Seguros", "Medicel", "Codil", "Nossa Seguros", "SAS", "IMPAR"])
  clinica           Clinica  @relation(fields: [clinicaId], references: [id])

  @@map("configuracoes_clinica")
}

model Notificacao {
  id           String     @id @default(cuid())
  utilizadorId String
  titulo       String
  mensagem     String
  tipo         String     @default("INFO")
  lida         Boolean    @default(false)
  url          String?
  criadoEm     DateTime   @default(now())
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@index([utilizadorId, lida])
  @@map("notificacoes")
}

model SystemLog {
  id           String      @id @default(cuid())
  nivel        String      @default("INFO")
  mensagem     String
  acao         String?
  utilizadorId String?
  detalhes     Json?
  criadoEm     DateTime    @default(now())
  utilizador   Utilizador? @relation(fields: [utilizadorId], references: [id])

  @@index([nivel])
  @@index([acao])
  @@map("system_logs")
}

model GlobalSettings {
  id                   String   @id @default("global_settings")
  modoManutencao       Boolean  @default(false)
  registoNovasClinicas Boolean  @default(true)
  maxUploadSizeMb      Int      @default(5)
  mensagemSistema      String?
  atualizadoEm         DateTime @updatedAt

  @@map("global_settings")
}

model Subscricao {
  id                String            @id @default(cuid())
  clinicaId         String
  clinica           Clinica           @relation(fields: [clinicaId], references: [id])

  plano             Plano
  estado            EstadoSubscricao  @default(TRIAL)

  // Datas de validade
  inicioEm          DateTime          @default(now())
  validaAte         DateTime?         // data de expiraÃ§Ã£o (null = nÃ£o expira â€” ENTERPRISE vitalÃ­cio)
  trialAte          DateTime?         // sÃ³ preenchido se estado = TRIAL

  // Billing
  valorKz           Int?              // valor pago em Kwanzas (null se gratuito/trial)
  referenciaInterna String?           // ex: "INV-2026-0042" â€” referÃªncia da invoice gerada

  // HistÃ³rico de mudanÃ§a
  razao             RazaoMudancaPlano @default(UPGRADE_MANUAL)
  planoAnterior     Plano?            // null na primeira subscriÃ§Ã£o
  alteradoPor       String            @default("SISTEMA")
  notas             String?           // notas internas do Super Admin

  criadoEm          DateTime          @default(now())
  atualizadoEm      DateTime          @updatedAt
  
  notificacoes      SubscricaoNotificacao[]

  @@index([clinicaId, estado])
  @@index([clinicaId, criadoEm(sort: Desc)])
  @@index([validaAte])             // para o job nocturno de expiraÃ§Ã£o
  @@map("subscricoes")
}

// NotificaÃ§Ãµes de renovaÃ§Ã£o agendadas
model SubscricaoNotificacao {
  id           String   @id @default(cuid())
  subscricaoId String
  subscricao   Subscricao @relation(fields: [subscricaoId], references: [id])

  tipo         String   // "AVISO_30D" | "AVISO_7D" | "AVISO_1D" | "EXPIROU" | "GRACE_END"
  enviadoEm    DateTime?
  erro         String?

  @@unique([subscricaoId, tipo])
  @@map("subscricao_notificacoes")
}

model FaturaAssinatura {
  id             String    @id @default(cuid())
  clinicaId      String
  numero         String    @unique
  valor          Int
  moeda          String    @default("AOA")
  status         String    @default("PENDENTE")
  dataEmissao    DateTime  @default(now())

  dataPagamento  DateTime?
  dataVencimento DateTime
  urlPdf         String?
  clinica        Clinica   @relation(fields: [clinicaId], references: [id])

  @@index([clinicaId])
  @@map("faturas_assinatura")
}

model Fatura {
  id             String       @id @default(cuid())
  clinicaId      String
  numeroFatura   String
  agendamentoId  String?      @unique
  pacienteId     String
  medicoId       String?
  tipo           TipoFatura   @default(PARTICULAR)
  estado         EstadoFatura @default(RASCUNHO)
  subtotal       Int
  desconto       Int          @default(0)
  totalIva       Int          @default(0)
  total          Int
  notas          String?
  dataEmissao    DateTime?
  dataVencimento DateTime?

  // Campos Fiscais (AGT)
  tipoDocFiscal  TipoDocumentoFiscal @default(FT)
  serieDocFiscal String              @default("CPLS")
  valorExtenso   String?             // Total por extenso (obrigatÃ³rio AGT)
  retencaoFonte  Int                 @default(0)
  valorPago      Int                 @default(0) // Cache para parcelamento/display
  moeda          String              @default("AOA")
  fiscalHash     String?             // Assinatura RSA de 172 chars
  hashControl    String?             @default("1") // VersÃ£o do algoritmo
  documentoChave String?             // Dados concatenados para assinatura
  statusEnvio    String              @default("PENDENTE") // PENDENTE, ENVIADO, ERRO, CONTINGENCIA
  emContingencia Boolean             @default(false)     // Se foi emitida em contingência
  agtRequestID   String?             // Token retornado pela AGT

  // RelaÃ§Ãµes de AnulaÃ§Ã£o (NC)
  faturaOriginalId String?
  motivoAnulacao   String?
  faturaOriginal   Fatura?  @relation("FaturaAnulacao", fields: [faturaOriginalId], references: [id])
  notasCredito     Fatura[] @relation("FaturaAnulacao")

  snapshot       FaturaSnapshot?

  criadoEm       DateTime     @default(now())
  atualizadoEm   DateTime     @updatedAt
  agendamento    Agendamento? @relation(fields: [agendamentoId], references: [id])
  clinica        Clinica      @relation(fields: [clinicaId], references: [id])
  medico         Medico?      @relation(fields: [medicoId], references: [id])
  paciente       Paciente     @relation(fields: [pacienteId], references: [id])
  itens          ItemFatura[]
  pagamentos     Pagamento[]

  @@index([clinicaId])
  @@index([clinicaId, estado])
  @@index([clinicaId, pacienteId])
  @@index([clinicaId, dataEmissao])
  @@index([clinicaId, serieDocFiscal, tipoDocFiscal, estado])
  @@map("faturas")
}

model ItemFatura {
  id         String @id @default(cuid())
  faturaId   String
  descricao  String
  quantidade Int    @default(1)
  precoUnit      Int
  desconto       Int    @default(0)
  taxaIva        Float  @default(0)    // Ex: 14.0
  codigoIva      String @default("ISE") // Ex: IVA, ISE
  motivoIsencao  String?               // Requisito se taxaIva = 0
  total          Int
  fatura     Fatura @relation(fields: [faturaId], references: [id], onDelete: Cascade)

  @@map("itens_fatura")
}

model Pagamento {
  id         String           @id @default(cuid())
  clinicaId  String
  faturaId   String
  metodo     MetodoPagamento
  valor      Int
  referencia String?
  notas      String?

  // Campos Fiscais (RC)
  numeroRecibo String?  // Ex: RC CPLS/1
  fiscalHash   String?  // Assinatura RSA do Recibo
  documentoChave String? // Dados concatenados para assinatura

  criadoEm   DateTime         @default(now())
  criadoPor  String
  fatura     Fatura           @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  seguro     SeguroPagamento?

  @@index([clinicaId])
  @@index([faturaId])
  @@map("pagamentos")
}

model SeguroPagamento {
  id                 String       @id @default(cuid())
  pagamentoId        String       @unique
  seguradora         String
  numeroBeneficiario String
  numeroAutorizacao  String?
  estado             EstadoSeguro @default(PENDENTE)
  valorSolicitado    Int
  valorAprovado      Int?
  dataSubmissao      DateTime?
  dataResposta       DateTime?
  notasSeguradora    String?
  pagamento          Pagamento    @relation(fields: [pagamentoId], references: [id])

  @@map("seguros_pagamento")
}

model Prontuario {
  id            String       @id @default(cuid())
  clinicaId     String
  pacienteId    String
  medicoId      String
  agendamentoId String?      @unique
  notas         String
  diagnostico   String?
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt
  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id])
  clinica       Clinica      @relation(fields: [clinicaId], references: [id])
  medico        Medico       @relation(fields: [medicoId], references: [id])
  paciente      Paciente     @relation(fields: [pacienteId], references: [id])

  @@index([clinicaId])
  @@index([pacienteId])
  @@map("prontuarios")
}

model Exame {
  id               String       @id @default(cuid())
  clinicaId        String
  pacienteId       String
  medicoId         String
  agendamentoId    String?
  
  nome             String       // legado
  tipo             TipoExame    @default(LABORATORIO) // legado
  status           String       @default("PENDENTE")  // status antigo (legado)
  resultado        String?      // legado
  dataPedido       DateTime     @default(now())
  dataResultado    DateTime?
  
  // -- NOVOS CAMPOS DO MÃ“DULO (SPRINT I) --
  tipoExameId      String?           // NOVO: Link opcional para o catÃ¡logo
  descricao        String?           // NOVO: indicaÃ§Ã£o clÃ­nica/observaÃ§Ãµes
  estado           EstadoExame       @default(PENDENTE) // NOVO: mÃ¡quina de estados tipada
  dataRealizacao   DateTime?         // NOVO
  laudoUrl         String?           // NOVO: URL do ficheiro no Supabase
  laudoNota        String?           // NOVO: texto complementar ao ficheiro
  
  criadoEm         DateTime     @default(now())
  atualizadoEm     DateTime     @updatedAt  // NOVO: tracking correto (caso falte no original)
  
  agendamento      Agendamento? @relation(fields: [agendamentoId], references: [id])
  clinica          Clinica      @relation(fields: [clinicaId], references: [id])
  medico           Medico       @relation(fields: [medicoId], references: [id])
  paciente         Paciente     @relation(fields: [pacienteId], references: [id])
  tipoCatalogo     TipoExameClinica? @relation(fields: [tipoExameId], references: [id]) // NOVO

  @@index([clinicaId])
  @@index([pacienteId])
  @@index([clinicaId, estado]) // NOVO
  @@map("exames")
}

model Documento {
  id            String        @id @default(cuid())
  clinicaId     String
  pacienteId    String
  medicoId      String?
  agendamentoId String?
  tipo          TipoDocumento
  nome          String
  url           String
  criadoEm      DateTime      @default(now())
  agendamento   Agendamento?  @relation(fields: [agendamentoId], references: [id])
  clinica       Clinica       @relation(fields: [clinicaId], references: [id])
  medico        Medico?       @relation(fields: [medicoId], references: [id])
  paciente      Paciente      @relation(fields: [pacienteId], references: [id])

  @@index([clinicaId])
  @@index([pacienteId])
  @@map("documentos")
}

model WaInstancia {
  id             String             @id @default(cuid())
  clinicaId      String
  /// Nome da instÃ¢ncia na Evolution API ("cp-slug-abc123"). Pode ser vazio em instÃ¢ncias Meta puras.
  evolutionName  String             @unique
  evolutionToken String
  estado         WaEstadoInstancia  @default(DESCONECTADO)
  numeroTelefone String?
  qrCodeBase64   String?
  qrExpiresAt    DateTime?
  criadoEm       DateTime           @default(now())
  atualizadoEm   DateTime           @updatedAt

