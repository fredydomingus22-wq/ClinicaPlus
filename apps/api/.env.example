# ──────────────────────────────────────────────────────────────────────────────
# ClinicaPlus API — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Transaction mode (port 6543) — used by Prisma at runtime (connection pooling)
DATABASE_URL="postgresql://postgres.xyjuprkouwkxkrdkyvup:MalhadoM11!@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used ONLY by Prisma migrate (no pooler)
DIRECT_URL="postgresql://postgres.xyjuprkouwkxkrdkyvup:MalhadoM11!@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"
# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="<64+ character random string>"

# Must be DIFFERENT from JWT_SECRET
# Generate with: openssl rand -base64 64
JWT_REFRESH_SECRET="<64+ character random string — different from above>"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Frontend ──────────────────────────────────────────────────────────────────
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key at: https://resend.com/api-keys
# Dev:  re_test_...  (sandbox — only sends to verified addresses)
# Prod: re_live_...  (requires verified domain in Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Multi-tenancy (Subdomínios) ───────────────────────────────────────────────
# Domínio base para tenants por subdomínio (ex: nutrimacho.clinicaplus.ao)
# Opcional — se não definido, wildcard CORS para subdomínios fica desactivado
# TENANT_BASE_DOMAIN=clinicaplus.ao

# ── Infrastructure (V2) ──────────────────────────────────────────────────────
# Redis URL (format: redis://[:password@]host:port[/db-number])
REDIS_URL=redis://localhost:6379

# ── Monitoring ────────────────────────────────────────────────────────────────
METRICS_TOKEN=<random token min 8 chars>
# ── WhatsApp (Evolution API) ──────────────────────────────────────────────────
EVOLUTION_API_URL=https://api.vossa-evolution.com
EVOLUTION_API_KEY=apikey_gerada_na_evolution
EVOLUTION_WEBHOOK_SECRET=secret_para_validar_assinatura
# ── n8n (Automations) ─────────────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.vossa-instancia.com
N8N_API_KEY=apikey_gerada_no_n8n
API_PUBLIC_URL=https://api.clinicaplus.ao

# ── Testing & CI (V2) ─────────────────────────────────────────────────────────
# BASE_URL is used by k6 load tests
BASE_URL=http://localhost:3001
# STAGING_URL and STAGING_API_URL (used for secrets in CI)
STAGING_URL=https://staging.clinicaplus.ao
STAGING_API_URL=https://api-staging.clinicaplus.ao

# ── AGT (Facturação Electrónica) ───────────────────────────────────────────────
# Ambiente: sandbox ou production
AGT_ENV=sandbox
# Credenciais AGT (Basic Auth - solicitar a produtores.dfe.dcrr.agt@minfin.gov.ao)
AGT_USERNAME=seu_username_agt
AGT_PASSWORD=sua_password_agt
# Chave RSA privada do produtor (obtida na certificação AGT)
AGT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
# Chave RSA pública do produtor
AGT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
# Identificação do software (obtida na certificação AGT)
AGT_PRODUCT_ID=DocAgen
AGT_PRODUCT_VERSION=1.0.0
AGT_SOFTWARE_CERTIFICATE=seu_certificado_jws
# Código EAC da actividade
AGT_EAC_CODE=86201
# Mock mode para desenvolvimento (desativa envio real)
AGT_MOCK=true
